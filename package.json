{
  "name": "dube-nails",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4000",
    "build": " ng build -c production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "move": "npm run build && rm -r ../api-rest-dube/public/* && mv ./dist/dube-nails/* ../api-rest-dube/public",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --include=src/app/services/agenda.service.spec.ts --include=src/app/pages/agenda/components/calendario/calendario.component.spec.ts --include=src/app/pages/agenda/components/modal-register/modal-register.component.spec.ts --include=src/app/interceptores/auth.interceptor.spec.ts --include=src/app/shared/header/components/menu/components/login/login.component.spec.ts --include=src/app/shared/header/components/menu/normalizar-imagen.spec.ts --include=src/app/pages/reservar/reservar.component.spec.ts --include=src/app/shared/footer/footer.component.spec.ts --include=src/app/pages/mis-citas/mis-citas.component.spec.ts --include=src/app/shared/header/components/menu/components/registro/registro.component.spec.ts --include=src/app/pages/productos/update-productos/update-productos.component.spec.ts --include=src/app/pages/usuario/usuario.component.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.3",
    "@angular/cdk": "^17.3.3",
    "@angular/common": "^17.3.3",
    "@angular/compiler": "^17.3.3",
    "@angular/core": "^17.3.3",
    "@angular/forms": "^17.3.3",
    "@angular/platform-browser": "^17.3.3",
    "@angular/platform-browser-dynamic": "^17.3.3",
    "@angular/router": "^17.3.3",
    "@angular/service-worker": "^17.3.3",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/core": "^8.0.2",
    "moment": "^2.29.4",
    "ngx-mask": "^17.0.7",
    "pouchdb-browser": "^7.3.0",
    "rxjs": "~7.5.0",
    "sweetalert2": "^11.5.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.10",
    "@angular/cli": "~17.3.3",
    "@angular/compiler-cli": "^17.3.3",
    "@types/jasmine": "~4.0.0",
    "jasmine-core": "~4.2.0",
    "karma": "~6.4.0",
